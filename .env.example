# Copy to .env (setup.sh does this). Blank secrets are generated automatically.
AIRFLOW_VERSION=3.3.2
AIRFLOW_PORT=8080
POSTGRES_PORT=5433
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
FERNET_KEY=
JWT_SECRET=
# Linux only: your numeric user id, so mounted files aren't root-owned
AIRFLOW_UID=
# Extra pip packages (space-separated), if a DAG needs them
_PIP_ADDITIONAL_REQUIREMENTS=
